// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SectorType {
  urban
  rural
}

enum TenureType {
  owner
  tenant
  occupant
  possessor
  not_informed
}

enum PropertyStatus {
  habitable
  uninhabitable
  destroyed
  damaged
}

enum PropertyType {
  housing
  farm
  commercial_premises
  factory
  warehouse
  lot
  wellness_center
  educational_center
  senior_center
  hospital
  stadium
  church
  municipality
  police_station
  other
}

enum DocumentType {
  citizenship_id
  identity_card
  birth_certificate
  passport
  ppt
  pep
  foreign_id
  nit
}

enum GenderIdentity {
  woman
  man
  transgender
  other
  prefer_not_to_say
}

enum EthnicAffiliation {
  indigenous
  gitano_rom
  raizal
  palenquero
  negro
  mulato
  afrodescendant
  afrocolombian
  not_applicable
}

enum DisabilityCondition {
  visual
  auditory
  physical
  cognitive
  none
  other
}

enum Relationship {
  head_of_household
  partner
  spouse
  son_daughter
  stepchild
  grandparent
  nephew_niece
  grandchild
  uncle_aunt
  father
  mother
  father_in_law_mother_in_law
  brother_sister
  half_brother_half_sister
  son_in_law
  daughter_in_law
  brother_in_law_sister_in_law
  cousin
  other_relative
  non_relative
  not_informed
}

enum PetType {
  dog
  cat
  bird
  rabbit
  other
}

model HouseholdSurvey {
  id           String    @id @default(uuid())
  censusNumber Int     @unique @default(autoincrement()) @map("census_number")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz()

  housing Housing?
  people  Person[]
  pets    Pet[]

  @@map("household_survey")
}

model Housing {
  id                    String         @id @default(uuid())
  surveyId              String         @unique @map("survey_id")
  survey                HouseholdSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  neighborhoodId        String?        @map("neighborhood_id")
  neighborhood          Neighborhood?  @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  neighborhoodOrSector  String?        @map("neighborhood_or_sector")
  address               String
  sectorType            SectorType     @map("sector_type")
  farmNameOrReference   String?        @map("farm_name_or_reference")
  stratum               Int
  tenureType            TenureType     @map("tenure_type")
  propertyStatus        PropertyStatus @map("property_status")
  damageDescription     String?        @map("damage_description")
  wasEvacuated          Boolean        @map("was_evacuated")
  propertyType          PropertyType   @map("property_type")
  propertyTypeOther     String?        @map("property_type_other")
  totalFamilies         Int            @map("total_families")
  householdMembersCount Int            @map("household_members_count")
  peopleToRegister      Int            @map("people_to_register")
  petsToRegister        Int            @default(0) @map("pets_to_register")
  contactNumber         String         @map("contact_number")
  longitude             Decimal?       @map("longitude") @db.Decimal(12, 8)
  latitude              Decimal?       @map("latitude") @db.Decimal(12, 8)

  @@map("housing")
}

model Person {
  id                 String          @id @default(uuid())
  surveyId           String          @map("survey_id")
  survey             HouseholdSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  orderIndex         Int             @map("order_index")
  firstNames         String          @map("first_names")
  lastNames          String          @map("last_names")
  documentType       DocumentType    @map("document_type")
  documentNumber     String          @map("document_number")
  relationship             Relationship       @map("relationship")
  epsId                    String?            @map("eps_id")
  eps                      Eps?               @relation(fields: [epsId], references: [id], onDelete: SetNull)
  epsOther                 String?            @map("eps_other")
  genderIdentity           GenderIdentity     @map("gender_identity")
  birthDate          DateTime        @map("birth_date") @db.Date
  ethnicAffiliation        EthnicAffiliation  @map("ethnic_affiliation")
  phoneNumber              String?            @map("phone_number")
  email                    String?            @map("email")
  disabilityCondition      DisabilityCondition @map("disability_condition")
  disabilityConditionOther String?            @map("disability_condition_other")

  @@unique([surveyId, orderIndex])
  @@map("person")
}

model Pet {
  id        String          @id @default(uuid())
  surveyId  String          @map("survey_id")
  survey    HouseholdSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  orderIndex Int           @map("order_index")
  petType   PetType
  name      String?

  @@unique([surveyId, orderIndex])
  @@map("pet")
}

model Neighborhood {
  id        String    @id @default(uuid())
  name      String    @unique
  comuna    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  housings  Housing[]

  @@map("neighborhood")
}

model Eps {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  people    Person[]

  @@map("eps")
}
